{
  "name": "what-would-camus-say",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "pnpm build:index",
    "dev": "vite",
    "build": "pnpm content:validate:production && pnpm build:index && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "pnpm build:index",
    "test:e2e": "playwright test",
    "build:index": "node --import tsx scripts/build-index.ts",
    "content:generate:batch02": "node --import tsx scripts/generate-batch-02.ts",
    "content:generate:batch03": "node --import tsx scripts/generate-batch-03.ts",
    "evaluate:retrieval": "node --import tsx scripts/evaluate-retrieval.ts",
    "evaluate:safety": "node --import tsx scripts/evaluate-safety.ts",
    "benchmark:retrieval": "pnpm build:index && node --import tsx scripts/benchmark-retrieval.ts",
    "audit:accessibility": "node scripts/audit-accessibility.mjs",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "content:validate:production": "node --import tsx scripts/validate-content.ts --production",
    "check:architecture": "node scripts/check-architecture.mjs",
    "validate": "pnpm format:check && pnpm lint && pnpm test && pnpm content:validate && pnpm build:index && pnpm evaluate:retrieval && pnpm evaluate:safety && pnpm benchmark:retrieval && pnpm check:architecture",
    "validate:production": "pnpm validate && pnpm evaluate:retrieval -- --production && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "chrome-launcher": "^1.2.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "lighthouse": "^13.4.1",
    "prettier": "3.9.6",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
